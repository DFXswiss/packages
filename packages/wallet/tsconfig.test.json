{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.json"]
}
