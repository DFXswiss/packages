{
  "extends": "../../tsconfig.build.json",
  "include": ["./src/**/*.ts", "./src/**/*.json"],
  "exclude": ["./src/__tests__/**"],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["dom", "dom.iterable", "esnext"],
    // Compiled as a project reference by the wallet's newer TypeScript.
    // The repository @types packages disagree with that library.
    "skipLibCheck": true
  }
}
